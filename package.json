{
  "name": "code-to-docx",
  "private": false,
  "version": "1.3.0",
  "description": "Create auditable DOCX archives from source code for humans and agents",
  "main": "src/index.mjs",
  "bin": {
    "code-to-docx": "src/index.mjs",
    "c2d": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "prepack": "node scripts/generate-version.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:package": "node tests/package-smoke.mjs"
  },
  "author": "xllily",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "app-settings.json",
    "LICENSE",
    "README.md",
    "skills",
    "src/cli.mjs",
    "src/index.mjs",
    "src/utils/generate.mjs",
    "src/utils/scan.mjs",
    "src/version.mjs"
  ],
  "keywords": [
    "agent-skill",
    "cli",
    "code-archive",
    "code-to-docx",
    "docx",
    "source-code",
    "word"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "docx": "^9.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/core": "^7.25.8",
    "@babel/node": "^7.25.7",
    "@babel/preset-env": "^7.25.8",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "mammoth": "^1.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xllily/code-to-docx.git"
  },
  "bugs": {
    "url": "https://github.com/xllily/code-to-docx/issues"
  },
  "homepage": "https://github.com/xllily/code-to-docx#readme"
}
