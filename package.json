{
  "name": "code-to-docx",
  "private": false,
  "version": "1.3.2",
  "description": "Export source code and entire codebases to structured Word DOCX archives with a CLI and Agent Skill",
  "main": "src/index.mjs",
  "bin": {
    "code-to-docx": "src/index.mjs",
    "c2d": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "prepack": "node scripts/generate-version.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:artifact": "node tests/package-artifact-regression.mjs",
    "test:package": "node tests/package-smoke.mjs",
    "test:published": "node tests/published-package-regression.mjs",
    "test:skill": "node tests/skill-install-regression.mjs",
    "test:agent": "node tests/agent-runtime-smoke.mjs",
    "test:agent:local": "npm run test:agent -- codex && npm run test:agent -- claude-code"
  },
  "author": "xllily",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "app-settings.json",
    "LICENSE",
    "README.md",
    "skills",
    "src/cli.mjs",
    "src/index.mjs",
    "src/utils/generate.mjs",
    "src/utils/scan.mjs",
    "src/version.mjs"
  ],
  "keywords": [
    "agent-skill",
    "cli",
    "code-archive",
    "code-to-docx",
    "code-to-word",
    "docx",
    "export-code",
    "source-code",
    "source-code-to-docx",
    "word-document",
    "word"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "docx": "^9.7.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/core": "^7.25.8",
    "@babel/node": "^7.25.7",
    "@babel/preset-env": "^7.25.8",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "mammoth": "^1.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xllily/code-to-docx.git"
  },
  "bugs": {
    "url": "https://github.com/xllily/code-to-docx/issues"
  },
  "homepage": "https://github.com/xllily/code-to-docx#readme"
}
